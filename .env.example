# Copy to .env. Never commit the real thing.

# Without this, every AI call (audit, appeal drafting, jargon translation, read-aloud,
# transcription) throws MissingKeyError. The three demo cases still render — their audits are
# precomputed and stored — but "Try the auditor" and appeal drafting stop working.
OPENAI_API_KEY=

# Without this, every database call throws and every page falls back to the committed fixture
# copy of the three demo cases (behind an honest banner). MUST use port 5432 (session pooler),
# not 6543 (transaction pooler) — ledger_append() holds a session-scoped advisory lock that the
# transaction pooler cannot preserve, so writes will fail or silently misbehave on 6543 even
# though reads look fine. src/lib/db.ts rewrites 6543->5432 defensively, but set it right here.
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# Without this, ledger hashes are unsalted and any receipt generated before it was set becomes
# unverifiable once it is changed. Set once, before the first `pnpm seed`, and never rotate it
# on a database that already has ledger rows.
LEDGER_PEPPER=change-me

# Selects which grievance adapter serves cases. "mock" (default) is the only value that should
# ever be set for this submission — it uses synthetic seeded data and never touches a live
# government system. Leave unset or "mock"; do not point this at a real system.
GRIEVANCE_SYSTEM=mock

# Optional model overrides. Leave unset to use the defaults in src/lib/agents/openai.ts.
# Each swaps one tier's model without a code change; wrong values fail the first call that uses
# that tier.
MODEL_REASONING=
MODEL_FAST=
MODEL_CONVERSATIONAL=
MODEL_VISION=
MODEL_EMBEDDING=
MODEL_TRANSCRIBE=
MODEL_TTS=
